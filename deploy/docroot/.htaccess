# Zusammen mit proxy.php in den Web-Root der Radar-Subdomain legen.
# Leitet alle Anfragen an den PHP-Proxy (der an Gunicorn weiterreicht).
# HTTPS wird von der Infomaniak-Plattform erzwungen (Panel), NICHT hier.

RewriteEngine On

# proxy.php selbst direkt ausliefern (sonst Endlosschleife)
RewriteRule ^proxy\.php$ - [L]

# alles Übrige durch den Proxy
RewriteRule ^ proxy.php [QSA,L]
